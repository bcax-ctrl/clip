# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=                # optional GPT-4 fallback

# ─── Market data ────────────────────────────────────────────────────────────────
COINGECKO_API_KEY=             # optional (free tier works without)
ALPHA_VANTAGE_API_KEY=         # optional (macro agent / FX)
NEWS_API_KEY=                  # optional (sentiment agent headlines)
BINANCE_API_KEY=               # READ-ONLY key recommended for portfolio sync
BINANCE_SECRET=

# ─── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=                  # leave blank to use the in-memory store
SUPABASE_KEY=

# ─── Base chain ───────────────────────────────────────────────────────────────────
BASE_RPC=https://mainnet.base.org
SMART_CONTRACT_ADDRESS=        # from contracts/ deploy
WALLET_PRIVATE_KEY=            # ONLY needed for on-chain execution

# ─── Auth / safety ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=                # optional 32-byte urlsafe-base64 Fernet key
AUTO_TRADE_ENABLED=false       # keep false until you've verified everything
MAX_SLIPPAGE_BPS=100           # 1.00%
ENABLE_AUTO_ANALYSIS=true      # 5-minute background analysis loop

# ─── Frontend ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

REDIS_URL=redis://redis:6379
