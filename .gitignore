# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# runtime job storage (rendered videos, transcripts, .ass, etc.)
/jobs/*
!/jobs/.gitkeep

# user-supplied royalty-free music (don't commit copyrighted audio)
/public/music/**/*.mp3
/public/music/**/*.m4a
/public/music/**/*.wav

# user-supplied fonts (licensing varies)
/public/fonts/*.ttf
/public/fonts/*.otf

# misc
.DS_Store
*.pem
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
