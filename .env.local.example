# Anthropic API key — used for AI viral-moment detection.
ANTHROPIC_API_KEY=your_key_here

# Optional: OpenAI key if you prefer the hosted Whisper API over the local CLI.
OPENAI_API_KEY=

# Whisper model: tiny | base | small | medium
WHISPER_MODEL=base

# Root directory for uploads, transcripts, and generated clips.
UPLOAD_DIR=/tmp/clipmine

# Client-side upload guard (megabytes).
MAX_FILE_SIZE_MB=2000

# Claude model used for clip detection.
ANTHROPIC_MODEL=claude-opus-4-8
