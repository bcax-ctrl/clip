ANTHROPIC_API_KEY=your_key_here

# --- Speed / quality knobs ---
# Whisper model: tiny (fastest) | base | small | medium | large (most accurate)
WHISPER_MODEL=tiny
# Force a language to skip auto-detection (e.g. en, id). Leave empty to auto-detect.
WHISPER_LANGUAGE=
# x264 preset: ultrafast | superfast | veryfast | faster | fast | medium
FFMPEG_PRESET=veryfast
# Set to true to render all 10 grading layers for the Before/After explorer.
# Default (false) renders only raw + final — much faster.
FULL_LAYERS=false

UPLOAD_DIR=/tmp/clipmine
MAX_FILE_SIZE_MB=2000
DEMO_MODE=false
