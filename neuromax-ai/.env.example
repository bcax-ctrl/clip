# ─── AI / LLM ────────────────────────────────────────────────────────────────
# Primary model provider. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used by the agent orchestrator. claude-sonnet-4-6 is the project default.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional GPT-4 fallback (only used if set; see backend/ai-service/claude_client.py)
OPENAI_API_KEY=

# ─── Market data providers ─────────────────────────────────────────────────────
# CoinGecko free tier works without a key; a demo key raises rate limits.
COINGECKO_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET=

# ─── Datastores ────────────────────────────────────────────────────────────────
# Inside docker-compose these hostnames resolve to the service names.
DATABASE_URL=postgresql://neuromax:neuromax@postgres:5432/neuromax
REDIS_URL=redis://redis:6379

# ─── Auth (API gateway) ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Service wiring ──────────────────────────────────────────────────────────────
# URL the gateway uses to reach the FastAPI AI service.
AI_SERVICE_URL=http://ai-service:8000
# URL the browser uses to reach the gateway.
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL the browser uses for the realtime socket (gateway proxies to ai-service WS).
NEXT_PUBLIC_WS_URL=ws://localhost:8000
